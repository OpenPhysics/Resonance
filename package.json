{
  "name": "resonance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "phet": {
    "simulation": true,
    "runnable": true,
    "supportedBrands": [
      "made-with-scenerystack"
    ],
    "simFeatures": {
      "colorProfiles": [
        "default",
        "projector"
      ],
      "supportsDynamicLocale": true,
      "supportsInteractiveDescription": true,
      "supportsInteractiveHighlights": true,
      "supportsVoicing": false,
      "supportsPanAndZoom": true,
      "supportsSound": false
    }
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "release": "npm version patch && git push && git push --tags",
    "check": "tsc --noEmit",
    "serve": "serve -s dist",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:fuzz": "playwright test --project=chromium",
    "test:fuzz:headed": "playwright test --project=chromium --headed",
    "test:fuzz:quick": "FUZZ_DURATION=30 playwright test --project=chromium fuzz.spec.ts",
    "test:fuzz:long": "FUZZ_DURATION=300 playwright test --project=chromium fuzz.spec.ts"
  },
  "dependencies": {
    "scenerystack": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.58.0",
    "@vitest/coverage-v8": "^4.1.8",
    "canvas": "^3.2.0",
    "jsdom": "^27.4.0",
    "serve": "^14.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

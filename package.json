{
  "name": "resonance",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Interactive simulation of resonance in driven oscillating systems. Visualizes driven mass-spring systems and Chladni plate patterns.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPhysics/Resonance.git"
  },
  "keywords": [
    "resonance",
    "simulation",
    "SceneryStack",
    "interactive",
    "physics",
    "oscillations",
    "waves",
    "education",
    "pwa"
  ],
  "phet": {
    "simulation": true,
    "runnable": true,
    "supportedBrands": [
      "made-with-scenerystack"
    ],
    "simFeatures": {
      "colorProfiles": [
        "default",
        "projector"
      ],
      "supportsDynamicLocale": true,
      "supportsInteractiveDescription": true,
      "supportsInteractiveHighlights": true,
      "supportsVoicing": false,
      "supportsPanAndZoom": true,
      "supportsSound": false
    }
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --mode single",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "release": "npm run check && npm run lint && npm run build && npm version patch && git push && git push --tags",
    "watch": "tsc --watch",
    "icons": "tsx scripts/generate-icons.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:fuzz": "playwright test --project=chromium",
    "test:fuzz:headed": "playwright test --project=chromium --headed",
    "test:fuzz:quick": "FUZZ_DURATION=30 playwright test --project=chromium fuzz.spec.ts",
    "test:fuzz:long": "FUZZ_DURATION=300 playwright test --project=chromium fuzz.spec.ts",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "scenerystack": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "three": "^0.125.0",
    "minimatch": "^3.1.3"
  }
}
